# Copy this file to ".env" and fill in your values.
# NEVER commit .env to GitHub - it holds your secrets. (.gitignore already blocks it.)
# With everything empty, the app runs in DEMO MODE (sample disputes + offline AI).

# --- PayPal (developer.paypal.com -> Apps & Credentials -> Sandbox -> your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From: python3 scripts/setup.py webhook https://your-app.onrender.com
PAYPAL_WEBHOOK_ID=

# --- AI model (any OpenAI-compatible API). We use NVIDIA Nemotron served by Nebius.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
# Run: python3 spike/test_llm.py models   to list others
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional: switches on the Insights dashboard agent. Tested with this model on Nebius.
AGENT_MODEL=zai-org/GLM-5.3
# To switch to Gemini later, only change the 3 lines above, e.g.:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-model-id

# --- Seller rules (enforced by code, not AI)
SETTLE_MAX_USD=25
MAX_OFFER_PCT=50

# --- Dashboard login (REQUIRED once the app is on the internet)
ADMIN_USER=seller
ADMIN_PASSWORD=

# Re-check open disputes with PayPal every N minutes (0 = off)
WATCH_MINUTES=5
# Demo mode only: put the sample cases back this many minutes after a visitor's last change (0 = off)
DEMO_RESET_MINUTES=30
# Most AI team runs per hour from the web page, to protect your AI credits (0 = no limit)
AI_RUNS_PER_HOUR=30

# Local testing only: accept webhooks without a PayPal signature
ALLOW_UNVERIFIED_WEBHOOKS=false

# Speech-to-text for call recordings (Gnani). Leave empty to paste transcripts only.
GNANI_API_KEY=
# GNANI_LANGUAGE=en-IN   (default: English. Mixed English and Hindi comes out in English.)
